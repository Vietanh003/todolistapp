<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" isELIgnored="false" %>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>
<nav class="navbar navbar-expand-lg navbar-dark bg-primary">
    <div class="container-fluid">
        <button class="btn btn-light me-2 toggle-3d" id="toggleSidebar">
            <i class="fas fa-bars fa-3d-icon"></i>
        </button>
        <a class="navbar-brand fw-bold logo-3d" href="#">
            <span class="logo-text">ToPlan</span>
            <span class="logo-subtext">Your Task Companion</span>
        </a>
        <div class="dropdown mx-3">
            <button class="btn btn-light dropdown-toggle btn-3d" type="button" id="categoryDropdown" data-bs-toggle="dropdown">
                <i class="fas fa-list-ul me-2"></i> Danh mục công việc
            </button>
            <ul class="dropdown-menu dropdown-3d" id="category-list">
                <li><a class="dropdown-item text-muted">Đang tải...</a></li>
            </ul>
        </div>
        <div class="ms-auto d-flex align-items-center" id="userSection">
            <!-- Notification -->
            <div class="dropdown me-3">
                <button class="btn btn-light btn-3d position-relative" type="button" id="notificationDropdown" data-bs-toggle="dropdown">
                    <i class="fas fa-bell fa-3d-icon"></i>
                    <span id="notificationCount" class="badge-3d">0</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end dropdown-3d" id="notification-list" style="max-height: 300px; overflow-y: auto;">
                    <li><a class="dropdown-item text-muted">Đang tải thông báo...</a></li>
                </ul>
            </div>
            <!-- Login Button -->
            <a href="login.jsp" class="btn btn-light btn-3d" id="loginButton" style="display: none;">
                <i class="fas fa-sign-in-alt me-2"></i> Đăng nhập
            </a>
            <!-- User Dropdown -->
            <div class="dropdown" id="userDropdownContainer" style="display: none;">
                <button class="btn btn-light btn-3d dropdown-toggle d-flex align-items-center" type="button" id="userDropdown" data-bs-toggle="dropdown">
                    <img id="navbarAvatar" src="${pageContext.request.contextPath}/img/user-avatar.png" class="avatar-3d me-2" alt="Avatar">
                    <span id="navbarUsername">Người dùng</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end dropdown-3d">
                    <li><a class="dropdown-item" href="#" onclick="showUserInfo(); return false;"><i class="fas fa-user-cog me-2"></i> Xem thông tin</a></li>
                    <li><a class="dropdown-item text-danger" href="#" onclick="confirmLogout(); return false;"><i class="fas fa-sign-out-alt me-2"></i> Đăng xuất</a></li>
                </ul>
            </div>
        </div>
    </div>
</nav>

<!-- User Info Modal -->
<div class="modal fade" id="userInfoModal" tabindex="-1" aria-labelledby="userInfoModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content modal-3d">
            <div class="modal-header">
                <h5 class="modal-title" id="userInfoModalLabel">Thông tin tài khoản</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="userInfoContent">
                <div class="text-center">
                    <img id="userAvatar" src="${pageContext.request.contextPath}/img/user-avatar.png" class="avatar-3d mb-3" alt="Avatar">
                    <h5 id="userName">Người dùng</h5>
                    <p id="userEmail" class="text-muted">Không có email</p>
                    <p id="userCreatedAt" class="text-muted">Ngày tạo: Không có thông tin</p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-3d" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<script>
    function confirmLogout() {
        showConfirmAlert('Bạn có chắc chắn muốn đăng xuất không?', () => {
            if (!window.contextPath) {
                console.error('window.contextPath không được định nghĩa');
                showErrorAlert('Lỗi cấu hình hệ thống.');
                return;
            }
            window.location.href = window.contextPath + '/logout';
        });
    }
</script>